<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>MomentForYou.Program</StartupObject>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MomentForYou.ico</ApplicationIcon>
    <AssemblyName>A moment for you</AssemblyName>
    <RootNamespace>MomentForYou</RootNamespace>
    <Title>A moment for you</Title>
    <Product>A moment for you</Product>
    <Description>A gentle reminder to step away, move around, and rest your eyes.</Description>
    <Copyright>© stud0709</Copyright>
    <Version>1.1.2</Version>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\MomentForYou.ico" />
    <Reference Include="System.Runtime.Serialization" />
    <!-- Build-time reference assemblies only; no runtime packages are shipped. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
