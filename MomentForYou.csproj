<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MomentForYou.ico</ApplicationIcon>
    <AssemblyName>A moment for you</AssemblyName>
    <RootNamespace>MomentForYou</RootNamespace>
    <Title>A moment for you</Title>
    <Product>A moment for you</Product>
    <Description>A gentle reminder to step away, move around, and rest your eyes.</Description>
    <Copyright>© stud0709</Copyright>
    <Version>1.0.1</Version>
    <!-- WPF owns the entry point and reads DPI awareness from the manifest.
         WinForms is used only for the tray and monitor enumeration. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\MomentForYou.ico" />
  </ItemGroup>
</Project>
