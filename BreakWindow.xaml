<Window x:Class="MomentForYou.BreakWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Make a break — A moment for you" Style="{StaticResource {x:Type Window}}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Width="1280" Height="800" Background="#101E1B" KeyDown="OnKeyDown" Closing="OnClosing">
  <Grid x:Name="Scene" ClipToBounds="True" TextElement.Foreground="{StaticResource Ink}">
    <Grid.Background><RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.8" RadiusY="0.9"><GradientStop Color="#20382E" Offset="0"/><GradientStop Color="#0D1816" Offset="1"/></RadialGradientBrush></Grid.Background>
    <Viewbox Margin="32" Stretch="Uniform" StretchDirection="DownOnly">
      <Grid Width="720" Height="680">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="680">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
            <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="A MOMENT FOR YOU" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
          </StackPanel>
          <Grid Width="96" Height="70" Margin="0,0,0,25">
            <Path Data="M 4,35 C 25,3 71,3 92,35 C 71,67 25,67 4,35 Z" Stroke="#C3E8AA" StrokeThickness="2"/>
            <Ellipse Width="24" Height="24" Stroke="#C3E8AA" StrokeThickness="2"/>
          </Grid>
          <TextBlock Text="Make a break" FontSize="58" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="Step away from your screen. Give your eyes some space." FontSize="18" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,16,0,34"/>
          <Border Background="#263D33" CornerRadius="18" Padding="28,24" BorderBrush="#3C5346" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel HorizontalAlignment="Center"><TextBlock Text="MOVE A LITTLE" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="Stand up &amp; stretch" FontSize="20" Margin="0,9,0,0"/></StackPanel>
              <Border Grid.Column="1" Background="#4B6252"/>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center"><TextBlock Text="LOOK INTO THE DISTANCE" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/><TextBlock Text="At least 6 metres away" FontSize="20" Margin="0,9,0,0"/></StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="Keep looking away for at least 20 seconds." FontSize="17" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,28,0,28"/>
          <Button x:Name="DoneButton" Content="Done" Width="200" Click="OnDone" AutomationProperties.Name="Done — return to work"/>
          <TextBlock Text="Take your time. Click Done when you return. · Esc to dismiss" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
      </Grid>
    </Viewbox>
    <Border x:Name="Footer" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Panel.ZIndex="10">
      <TextBlock FontSize="12" Foreground="{StaticResource Muted}">
        <Run x:Name="FooterVersion"/><Run Text=" · © stud0709 · "/><Hyperlink x:Name="HomepageLink" NavigateUri="https://github.com/stud0709/moment-for-you" RequestNavigate="OnProjectHomepage" Foreground="{StaticResource Accent}">Project homepage</Hyperlink>
      </TextBlock>
    </Border>
  </Grid>
</Window>
