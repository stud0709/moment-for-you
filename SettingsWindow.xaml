<Window x:Class="MomentForYou.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="A moment for you" Icon="Assets/MomentForYou.ico" Style="{StaticResource {x:Type Window}}" Width="490" Height="620" MinWidth="440" MinHeight="600" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid Margin="34" TextElement.Foreground="{StaticResource Ink}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="A MOMENT FOR YOU" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
      <TextBlock Text="A healthier rhythm." FontSize="30" FontWeight="SemiBold" Margin="0,12,0,10"/>
      <TextBlock Text="A small pause for your eyes, across every screen." TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource Muted}"/>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <Border Background="#20362D" Padding="18" CornerRadius="12" Margin="0,0,0,26"><StackPanel><TextBlock x:Name="Status" Text="Reminders are on" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="NextBreak" Text="Next break in 20:00" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
      <TextBlock Text="Remind me every" FontSize="15" Margin="0,0,0,10"/>
      <StackPanel Orientation="Horizontal"><TextBox x:Name="Interval" Text="20" Width="90" Padding="12,9" FontSize="20" Background="#20362D" Foreground="{StaticResource Ink}" BorderBrush="#4B6252" MaxLength="3" AutomationProperties.Name="Reminder interval in minutes"/><TextBlock Text="minutes" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/><Button Content="Save" Click="OnSave" Margin="24,0,0,0" Padding="22,10"/></StackPanel>
      <TextBlock x:Name="Feedback" Text="1–240 minutes · Take each break at your own pace." FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
      <CheckBox x:Name="Autostart" Content="Autostart with Windows" Click="OnAutostart" Foreground="{StaticResource Ink}" FontSize="15" Cursor="Hand" Margin="0,24,0,0" AutomationProperties.Name="Autostart with Windows"/>
      <TextBlock Text="Starts quietly in the tray when you sign in." FontSize="12" Foreground="{StaticResource Muted}" Margin="20,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Take a break now" Click="OnBreakNow" Padding="14,13"/><Button x:Name="PauseButton" Grid.Column="2" Content="Pause reminders" Click="OnPause" Background="#2C4438" Foreground="{StaticResource Ink}" Padding="14,13"/></Grid>
      <TextBlock Text="Closing this window keeps reminders in the tray.&#10;Right-click the tray icon to set the interval or exit." TextAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,22,0,0"/>
      <TextBlock x:Name="Footer" Style="{StaticResource AppFooterText}" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Run x:Name="FooterVersion"/><Run Text=" · © stud0709 · "/><Hyperlink x:Name="HomepageLink" NavigateUri="https://github.com/stud0709/moment-for-you" RequestNavigate="OnProjectHomepage" Style="{StaticResource ProjectHomepageLink}">Project homepage</Hyperlink>
      </TextBlock>
    </StackPanel>
  </Grid>
</Window>
